# 환경변수 — 자격증명이 커밋되면 안 된다 (EC-4)
.env
.env.local
.env*.local

# 원본 데이터 — 공공누리 범위 밖 재배포 방지
data/raw/
data/*.hwp
*.hwp

# Node
# 디렉터리뿐 아니라 작업 폴더에 건 심볼릭 링크도 막는다. 슬래시가 붙으면 링크 파일은 빠진다.
node_modules
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 측정 산출물은 커밋한다 (N-803 재현성) — 결과만 제외
results/*.tmp

# IDE
.idea/
*.iml
.vscode/

# 기타
.DS_Store
.vercel
*.log

# 측정 중간 산출물 — 완료본은 measure/로 옮긴다
results-*.jsonl
results-*.json

# 테스트가 매 실행마다 다시 쓰는 산출물 — 앱이 읽지 않는다
measure/pii-n501.json

# 개인 권한 설정 — 공유하지 않는다
.claude/settings.local.json
/.swc

# Workflow 로컬 실행 상태는 비공개 운영 데이터다.
.workflow-data/

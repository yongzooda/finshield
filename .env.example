# 복사해서 .env.local 로 쓸 것. .env.local 은 커밋 금지.

# ── Supabase ────────────────────────────────────────────────
# 런타임 전용 커넥션 (app_runtime 롤). 정적 자산 쓰기 권한 없음.
DATABASE_URL="SET_IN_VERCEL"

# 배치 전용. 로컬에서만 사용하고 Vercel 환경변수에 넣지 않는다 (P-502).
BATCH_DATABASE_URL="LOCAL_ONLY_SET_ME"

# service_role 키는 운영자 전용. 코드에서 쓰지 않는다.

# ── Claude API ──────────────────────────────────────────────
ANTHROPIC_API_KEY="SET_IN_VERCEL"
ANTHROPIC_MODEL="claude-opus-5"

# P0 공개 MCP는 보안·쿼터·conformance Gate 전까지 비활성화한다.
PUBLIC_MCP_ENABLED="false"

# ── 법제처 국가법령정보 OPEN API ────────────────────────────
LAW_API_OC="precase"
LAW_API_BASE="https://www.law.go.kr/DRF"

# ── 상한값 (비기능 N-2xx 초기값) ────────────────────────────
MAX_TOOL_CALLS_PER_CYCLE="12"
MAX_TOOL_CALLS_PER_SESSION="30"
MAX_FOLLOWUP_QUESTIONS="8"
MAX_FOLLOWUP_TOTAL="10"
MAX_STATEMENT_CHARS="4000"
SESSION_IDLE_MINUTES="30"

# 확신도 임계 — 하드코딩 금지. 모델 교체 시 재보정 (A-2·A-6)
CONFIDENCE_THRESHOLD="4"

# ── 레이트 리밋 (N-203) ─────────────────────────────────────
RATE_LIMIT_PER_MINUTE="30"
RATE_LIMIT_SESSIONS_PER_HOUR="5"
RATE_LIMIT_JUDGMENTS_PER_DAY="10"

# Claude API 하루 예산 (USD). 월 8~10만 원 ≈ $55~70 ≈ 일 $1.8~2.3 (N-204)
DAILY_BUDGET_USD=2.0
# 운영자 알림 웹훅 (선택) — POST를 받는 주소면 무엇이든 (N-303)
# OPS_ALERT_WEBHOOK_URL=

# FinShield 로컬 설정 예제. 복사해서 .env.local 로 쓰고 .env.local 은 커밋하지 않는다.
#
#   cp -n .env.example .env.local && chmod 600 .env.local
#
# 이 파일에는 실제 값을 적지 않는다. 값은 .env.local(로컬)과 Vercel 환경변수(배포)에만 둔다.
#
# ⚠ PreCase와의 분리
#   FinShield는 PreCase와 물리적으로 분리된 자원만 사용한다 (ADR 7절).
#   PreCase의 DB·API key·법제처 OC를 그대로 옮겨 적으면 FinShield의 쓰기가
#   PreCase 운영 데이터에 섞이고, B-SUPABASE-01은 구조적으로 통과할 수 없다.
#   현재 Runtime은 PreCase 기준선이라 아래 변수 이름과 상한값도 아직 PreCase
#   체계다. FinShield 기능명세 확정 뒤 코드·테스트와 함께 정리한다.

# ── Supabase ────────────────────────────────────────────────
# FinShield 전용 Supabase 프로젝트의 Supavisor transaction pooler DSN.
#   - 포트 6543 (transaction pooler). direct 5432를 Runtime에 쓰지 않는다.
#   - 최소 권한 app_runtime 롤. postgres·service_role 은 금지한다 (ADR 7절).
#   - 전용 프로젝트가 없으면 비워 두고 앱을 실행하지 않는다. 다른 프로젝트로 대체하지 않는다.
DATABASE_URL="SET_TO_FINSHIELD_DEDICATED_POOLER_DSN"

# 배치·Migration 전용. 로컬에서만 쓰고 Vercel 환경변수에 넣지 않는다.
# 배치 권한이 별도로 확인되기 전에는 실제 관리자 값을 넣지 않는다. 비워 두는 것이 기본이다.
BATCH_DATABASE_URL=""

# service_role 키와 Migration DSN 은 운영자 전용이다. 앱 코드와 브라우저에 넣지 않는다.

# ── Claude API ──────────────────────────────────────────────
# FinShield 전용 키를 쓴다. PreCase 키를 공유하면 api_budget 원장과 하루 예산이 섞인다.
ANTHROPIC_API_KEY="SET_TO_FINSHIELD_ANTHROPIC_KEY"

# P0 기본 모델은 ADR 4.1이 claude-sonnet-5 로 고정한다. claude-opus-5 는 별도 평가를
# 통과한 고위험 재판정에만 허용하며 기본 경로와 자동 fallback 에 쓰지 않는다 (ADR 4.2).
# 모델을 바꾸면 아래 CONFIDENCE_THRESHOLD 를 다시 보정해야 한다.
ANTHROPIC_MODEL="claude-sonnet-5"

# Cohere embed-v4.0 은 아직 Runtime 코드가 읽지 않는다. 검색 평가는 GitHub
# provider-spike Environment 의 값으로만 실행한다. Runtime 연동이 생기면 여기에 추가한다.
# COHERE_API_KEY=

# P0 공개 MCP 는 비활성화한다. false 외의 값을 넣으면 부팅이 실패한다 (E-021).
PUBLIC_MCP_ENABLED="false"

# ── 법제처 국가법령정보 OPEN API ────────────────────────────
# 본인 계정으로 발급받아 FinShield 사용이 승인된 OC 값을 넣는다.
# 등록 IP 와 실제 요청 IP 가 다르면 인증이 실패한다. Vercel 은 고정 egress IP 를
# 보장하지 않으므로 request-time Live 조회를 기본 경로로 두지 않는다 (ADR 8.1, B-LAW-01).
LAW_API_OC="SET_TO_YOUR_APPROVED_OC"
LAW_API_BASE="https://www.law.go.kr/DRF"

# ── 도구 호출 상한 (E-012 · AI-016) ─────────────────────────
MAX_TOOL_CALLS_PER_CYCLE="12"
MAX_TOOL_CALLS_PER_SESSION="30"

# ── 되묻기 상한 ─────────────────────────────────────────────
MAX_FOLLOWUP_QUESTIONS="8"
MAX_FOLLOWUP_TOTAL="10"

# ── 입력·세션 상한 ──────────────────────────────────────────
MAX_STATEMENT_CHARS="4000"
SESSION_IDLE_MINUTES="30"

# ── 확신도 임계 ─────────────────────────────────────────────
# 하드코딩 금지 대상이다. 모델을 바꾸면 재보정한다.
# 현재 값은 PreCase 기준선이며 FinShield 판정 체계로 검증된 값이 아니다.
CONFIDENCE_THRESHOLD="4"

# ── 예산·레이트 리밋 (N-OPS-003 · N-OPS-004) ────────────────
# Claude API 하루 예산 (USD). 호출 전 원자 예약, 종료 후 정산이 원칙이다.
DAILY_BUDGET_USD="2.0"
RATE_LIMIT_PER_MINUTE="30"
RATE_LIMIT_SESSIONS_PER_HOUR="5"
RATE_LIMIT_JUDGMENTS_PER_DAY="10"

# 운영자 알림 웹훅 (선택). POST 를 받는 주소면 된다. 비워 두면 /api/health 로만 드러난다.
# OPS_ALERT_WEBHOOK_URL=

# ── 시험 전용 플래그 ────────────────────────────────────────
# PRECASE_CI · PRECASE_LIVE · PRECASE_PHASE · PRECASE_SMOKE · PRECASE_VARIANT 는
# CI 와 시험 하네스가 쓰는 값이다. .env.local 에 설정하지 않는다.
# 순수 회귀 시험은 CI 의 가짜 설정과 PRECASE_CI=1 로 실행한다. PRECASE_LIVE 는 임의로 켜지 않는다.
